# Real provider keys live here, only ever loaded into the proxy container.
# The sandbox itself never sees these — opencode inside the sandbox uses a
# placeholder key (e.g. "sandbox") and routes through http://opencode-sandbox-proxy:4000.

# Anthropic — used for the proxy's /anthropic/* route.
ANTHROPIC_API_KEY=

# OpenAI — used for the proxy's /v1/* route.
OPENAI_API_KEY=

# Generic OpenAI-compatible upstream — used for the proxy's /compat/* route.
# Point this at LM Studio, Ollama, OpenRouter, vLLM, etc. Leave both blank to
# disable the /compat route entirely.
OPENAI_COMPAT_UPSTREAM=
OPENAI_COMPAT_API_KEY=

# Optional: override the upstream base URLs (e.g. for a regional Anthropic
# endpoint or a proxy in front of OpenAI). Defaults shown.
# ANTHROPIC_UPSTREAM=https://api.anthropic.com
# OPENAI_UPSTREAM=https://api.openai.com
