{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.5:0.8b",
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}",
        "baseURL": "http://opencode-sandbox-proxy:4000/anthropic"
      }
    },
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}",
        "baseURL": "http://opencode-sandbox-proxy:4000/v1"
      }
    },
    "ollama": {
      "name": "ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "sandbox",
        "baseURL": "http://opencode-sandbox-proxy:4000/compat"
      },
      "models": {
        "qwen3.5:0.8b": {
          "name": "qwen3.5:0.8b",
          "limit": { "context": 32768, "output": 8192 }
        },
        "qwen3.5:2b": {
          "name": "qwen3.5:2b",
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  }
}
